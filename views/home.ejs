    <script>

    const searchInput = document.getElementById("searchInput");
    const categoryInput = document.getElementById("categoryInput");
    const minPriceInput = document.getElementById("minPriceInput");
    const maxPriceInput = document.getElementById("maxPriceInput");
    const sortInput = document.getElementById("sortInput");
    const foodContainer = document.getElementById("foodContainer");
    const noResults = document.getElementById("noResults");
    const foodCount = document.getElementById("foodCount");

    const userIsLoggedIn = <%= isLoggedIn ? "true" : "false" %>;
    const userIsAdmin = <%= isAdminUser ? "true" : "false" %>;

    async function loadFoods(categoryFromButton = null) {

        try {

            foodContainer.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="spinner-border" role="status"></div>
                    <p class="mt-2">Loading foods...</p>
                </div>
            `;

            noResults.style.display = "none";

            const params = new URLSearchParams();

            const search = searchInput.value.trim();

            const category =
                categoryFromButton !== null
                    ? categoryFromButton
                    : categoryInput.value;

            const minPrice = minPriceInput.value;
            const maxPrice = maxPriceInput.value;
            const sort = sortInput.value;

            if (search) params.append("search", search);
            if (category) params.append("category", category);
            if (minPrice) params.append("minPrice", minPrice);
            if (maxPrice) params.append("maxPrice", maxPrice);
            if (sort) params.append("sort", sort);

            // Ask the existing /foods API for filtered data.
            // The URL in the browser address bar does NOT change.
            const response = await fetch("/foods?" + params.toString() + (params.toString() ? "&" : "") + "limit=100");

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.message || "Unable to load foods");
            }

            displayFoods(result.data || []);

        } catch (error) {

            console.error("Food filter error:", error);

            foodContainer.innerHTML = `
                <div class="col-12">
                    <div class="alert alert-danger">
                        Unable to load foods. Please try again.
                    </div>
                </div>
            `;

            foodCount.textContent = "";

        }

    }


    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    function displayFoods(foods) {

        foodContainer.innerHTML = "";

        foodCount.textContent =
            `${foods.length} food(s) found`;

        if (!foods.length) {

            noResults.style.display = "block";

            return;

        }

        noResults.style.display = "none";

        foods.forEach(food => {

            const restaurantName =
                food.restaurant
                    ? food.restaurant.name || "Restaurant"
                    : "Restaurant";

            const card = document.createElement("div");

            card.className =
                "col-xl-3 col-lg-4 col-md-6";

            card.innerHTML = `

                <div class="food-card">

                    <img
                        src="${escapeHtml(food.image || "")}"
                        class="food-image"
                        alt="${escapeHtml(food.name)}">

                    <div class="food-body">

                        <div class="food-name">
                            ${escapeHtml(food.name)}
                        </div>

                        <div class="rating">
                            ⭐ 4.5
                        </div>

                        <div class="category-text">
                            Category:
                            <strong>
                                ${escapeHtml(food.category || "")}
                            </strong>
                        </div>

                        <div class="restaurant-name">
                            🏪 ${escapeHtml(restaurantName)}
                        </div>

                        <div class="price">
                            ₹${escapeHtml(food.price)}
                        </div>

                        ${userIsLoggedIn
                            ? `
                                <div class="customer-actions">

                                    <form action="/cart/add" method="POST">
                                        <input
                                            type="hidden"
                                            name="foodId"
                                            value="${escapeHtml(food._id)}">

                                        <button
                                            class="cart-btn"
                                            type="submit">
                                            🛒 Add to Cart
                                        </button>
                                    </form>

                                </div>
                              `
                            : `
                                <button
                                    class="cart-btn"
                                    type="button"
                                    onclick="alert('Please login to order food')">
                                    🛒 Add to Cart
                                </button>
                              `
                        }

                        ${userIsAdmin
                            ? `
                                <div class="admin-actions">

                                    <a
                                        href="/foods/${escapeHtml(food._id)}/edit"
                                        class="edit-btn">
                                        ✏️ Edit
                                    </a>

                                    <form
                                        action="/foods/${escapeHtml(food._id)}/delete"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this food?');">

                                        <button
                                            type="submit"
                                            class="delete-btn">
                                            🗑️ Delete
                                        </button>

                                    </form>

                                </div>
                              `
                            : ""
                        }

                    </div>

                </div>
            `;

            foodContainer.appendChild(card);

        });

    }


    // Apply filters button
    document
        .getElementById("applyFilters")
        .addEventListener("click", () => {
            loadFoods();
        });


    // Category buttons
    document
        .querySelectorAll(".category-filter")
        .forEach(button => {

            button.addEventListener("click", () => {

                const category =
                    button.dataset.category;

                categoryInput.value = category;

                loadFoods(category);

                document
                    .getElementById("foods")
                    .scrollIntoView({
                        behavior: "smooth"
                    });

            });

        });


    // Clear filters
    document
        .getElementById("clearFilters")
        .addEventListener("click", () => {

            searchInput.value = "";
            categoryInput.value = "";
            minPriceInput.value = "";
            maxPriceInput.value = "";
            sortInput.value = "";

            loadFoods();

        });


    // Search when Enter is pressed
    searchInput.addEventListener("keydown", event => {

        if (event.key === "Enter") {

            event.preventDefault();

            loadFoods();

        }

    });

</script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>