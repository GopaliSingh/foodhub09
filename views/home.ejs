<!-- ================= FOODS ================= -->

<section id="foods" class="pb-4">

    <div class="container">

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <div class="section-title">🔥 Available Foods</div>
                <div class="section-subtitle">
                    Discover something delicious today
                </div>
            </div>

            <div id="foodCount" class="section-subtitle"></div>
        </div>

        <div class="row g-4" id="foodContainer">

            <% if (foods && foods.length > 0) { %>

                <% foods.forEach(food => { %>

                    <div class="col-xl-3 col-lg-4 col-md-6">

                        <div class="food-card">

                            <img
                                src="<%= food.image %>"
                                class="food-image"
                                alt="<%= food.name %>">

                            <div class="food-body">

                                <div class="food-name">
                                    <%= food.name %>
                                </div>

                                <div class="rating">
                                    ⭐ 4.5
                                </div>

                                <div class="category-text">
                                    Category:
                                    <strong><%= food.category %></strong>
                                </div>

                                <div class="restaurant-name">
                                    🏪
                                    <% if (food.restaurant) { %>
                                        <%= food.restaurant.name || "Restaurant" %>
                                    <% } else { %>
                                        Restaurant
                                    <% } %>
                                </div>

                                <div class="price">
                                    ₹<%= food.price %>
                                </div>

                                <% if (isLoggedIn) { %>

                                    <div class="customer-actions">

                                        <form action="/cart/add" method="POST">
                                            <input
                                                type="hidden"
                                                name="foodId"
                                                value="<%= food._id %>">

                                            <button
                                                class="cart-btn"
                                                type="submit">
                                                🛒 Add to Cart
                                            </button>
                                        </form>

    

                                    </div>

                                <% } else { %>

                                    <button
                                        class="cart-btn"
                                        type="button"
                                        onclick="alert('Please login to order food')">
                                        🛒 Add to Cart
                                    </button>

                                <% } %>

                                <% if (isAdminUser) { %>

                                    <div class="admin-actions">

                                        <a
                                            href="/foods/<%= food._id %>/edit"
                                            class="edit-btn">
                                            ✏️ Edit
                                        </a>

                                        <form
                                            action="/foods/<%= food._id %>/delete"
                                            method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this food?');">

                                            <button
                                                type="submit"
                                                class="delete-btn">
                                                🗑️ Delete
                                            </button>

                                        </form>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-12">
                    <div class="empty-box">
                        <div style="font-size:55px;">🍽️</div>
                        <h4>No food found</h4>
                        <p>Try changing your search or filters.</p>
                    </div>
                </div>

            <% } %>

        </div>

        <div
            id="noResults"
            class="empty-box"
            style="display:none;">

            <div style="font-size:55px;">🍽️</div>
            <h4>No food found</h4>
            <p>Try changing your search or filters.</p>

        </div>

    </div>

</section>


