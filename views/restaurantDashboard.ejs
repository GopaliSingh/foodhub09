<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Restaurant Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f6fa;
            color: #333;
        }

        .navbar {
            background: #222;
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h1 {
            font-size: 24px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            background: #ff6b35;
            padding: 10px 18px;
            border-radius: 6px;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .header {
            margin-bottom: 30px;
        }

        .header h2 {
            font-size: 30px;
            margin-bottom: 8px;
        }

        .header p {
            color: #777;
        }

        .orders-section {
            margin-top: 20px;
        }

        .orders-section > h2 {
            margin-bottom: 20px;
        }

        .no-orders {
            background: white;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
            color: #777;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        .order-card {
            background: white;
            padding: 25px;
            margin-bottom: 20px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .order-card h3 {
            margin-bottom: 18px;
            color: #222;
        }

        .order-info {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .order-info p {
            color: #555;
        }

        .order-info strong {
            color: #222;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            background: #eee;
            font-size: 14px;
            font-weight: bold;
        }

        .status-form {
            display: flex;
            gap: 10px;
            align-items: center;
            border-top: 1px solid #eee;
            padding-top: 18px;
        }

        .status-form select {
            padding: 9px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            background: white;
        }

        .status-form button {
            padding: 9px 16px;
            border: none;
            border-radius: 6px;
            background: #ff6b35;
            color: white;
            cursor: pointer;
            font-weight: bold;
        }

        .status-form button:hover {
            background: #e85a2a;
        }

        @media (max-width: 700px) {
            .navbar {
                padding: 15px 20px;
            }

            .container {
                margin: 25px auto;
            }

            .order-info {
                grid-template-columns: 1fr;
            }

            .status-form {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <h1>FoodHub</h1>

        <a href="/">
            Home
        </a>
    </nav>


    <div class="container">

        <div class="header">
            <h2>Restaurant Dashboard</h2>
            <p>Manage customer orders and update their status.</p>
        </div>


        <div class="orders-section">

            <h2>Customer Orders</h2>


            <% if (orders.length === 0) { %>

                <div class="no-orders">
                    <p>No orders yet.</p>
                </div>

            <% } else { %>


                <% orders.forEach(order => { %>

                    <div class="order-card">

                        <h3>
                            Order #<%= order._id %>
                        </h3>


                        <div class="order-info">

                            <p>
                                <strong>Customer:</strong>
                                <%= order.user.name %>
                            </p>

                            <p>
                                <strong>Email:</strong>
                                <%= order.user.email %>
                            </p>

                            <p>
                                <strong>Food:</strong>
                                <%= order.food.name %>
                            </p>

                            <p>
                                <strong>Price:</strong>
                                ₹<%= order.food.price %>
                            </p>

                            <p>
                                <strong>Quantity:</strong>
                                <%= order.quantity %>
                            </p>

                            <p><strong>Total:</strong> ₹<%= order.total %></p>

                            <p>
                                <strong>Status:</strong>

                                <span class="status">
                                    <%= order.status %>
                                </span>
                            </p>

                        </div>


                        <form
                            class="status-form"
                            action="/orders/<%= order._id %>/status"
                            method="POST"
                        >

                            <select name="status">

                                <option
                                    value="pending"
                                    <%= order.status === "pending" ? "selected" : "" %>
                                >
                                    Pending
                                </option>

                                <option
                                    value="confirmed"
                                    <%= order.status === "confirmed" ? "selected" : "" %>
                                >
                                    Confirmed
                                </option>

                                <option
                                    value="preparing"
                                    <%= order.status === "preparing" ? "selected" : "" %>
                                >
                                    Preparing
                                </option>

                                <option
                                    value="delivered"
                                    <%= order.status === "delivered" ? "selected" : "" %>
                                >
                                    Delivered
                                </option>

                                <option
                                    value="cancelled"
                                    <%= order.status === "cancelled" ? "selected" : "" %>
                                >
                                    Cancelled
                                </option>

                            </select>


                            <button type="submit">
                                Update Status
                            </button>

                        </form>

                    </div>

                <% }) %>

            <% } %>

        </div>

    </div>

</body>

</html>