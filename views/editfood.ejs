<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Food | FoodieHub</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        body {
            background: #f5f6fa;
            font-family: Arial, sans-serif;
        }

        .edit-container {
            max-width: 600px;
            margin: 60px auto;
        }

        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 8px 25px rgba(0,0,0,.1);
        }

        .btn-update {
            background: #ff493d;
            border: none;
            color: white;
        }

        .btn-update:hover {
            background: #e63b31;
            color: white;
        }

    </style>

</head>


<body>

<div class="container edit-container">

    <div class="card p-4">

        <h2 class="mb-4">
            ✏️ Edit Food
        </h2>


        <form
            action="/admin/foods/<%= food._id %>/update"
            method="POST">


            <!-- NAME -->

            <div class="mb-3">

                <label class="form-label">
                    Food Name
                </label>

                <input
                    type="text"
                    name="name"
                    class="form-control"
                    value="<%= food.name %>"
                    required>

            </div>


            <!-- PRICE -->

            <div class="mb-3">

                <label class="form-label">
                    Price
                </label>

                <input
                    type="number"
                    name="price"
                    class="form-control"
                    value="<%= food.price %>"
                    required>

            </div>


            <!-- CATEGORY -->

            <div class="mb-3">

                <label class="form-label">
                    Category
                </label>

                <select
                    name="category"
                    class="form-select"
                    required>

                    <option
                        value="Pizza"
                        <%= food.category === "Pizza" ? "selected" : "" %>>
                        Pizza
                    </option>

                    <option
                        value="Burger"
                        <%= food.category === "Burger" ? "selected" : "" %>>
                        Burger
                    </option>

                    <option
                        value="Dessert"
                        <%= food.category === "Dessert" ? "selected" : "" %>>
                        Dessert
                    </option>

                    <option
                        value="Drinks"
                        <%= food.category === "Drinks" ? "selected" : "" %>>
                        Drinks
                    </option>

                    <option
                        value="Chinese"
                        <%= food.category === "Chinese" ? "selected" : "" %>>
                        Chinese
                    </option>

                    <option
                        value="Indian"
                        <%= food.category === "Indian" ? "selected" : "" %>>
                        Indian
                    </option>

                </select>

            </div>


            <!-- IMAGE -->

            <div class="mb-4">

                <label class="form-label">
                    Image URL
                </label>

                <input
                    type="text"
                    name="image"
                    class="form-control"
                    value="<%= food.image || '' %>">

            </div>


            <div class="d-flex gap-2">

                <button
                    type="submit"
                    class="btn btn-update px-4">

                    💾 Update Food

                </button>


                <a
                    href="/restaurant-dashboard"
                    class="btn btn-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

</body>

</html>