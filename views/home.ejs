<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>FoodieHub | Good Food, Happy You</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #fafafa;
            color: #222;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            background: #111827 !important;
            padding: 15px 0;
        }

        .navbar-brand {
            font-size: 25px;
            font-weight: 800;
            color: white !important;
        }

        .brand-highlight {
            color: #ff4b3e;
        }

        .brand-tagline {
            display: block;
            font-size: 10px;
            color: #cbd5e1;
            font-weight: 400;
            margin-top: -5px;
        }

        .nav-link {
            color: #e5e7eb !important;
            margin: 0 10px;
            font-weight: 500;
        }

        .nav-link:hover {
            color: #ff4b3e !important;
        }

        .login-btn {
            border: 1px solid white;
            border-radius: 25px;
            padding: 8px 22px !important;
        }

        .register-btn {
            background: #ff493d;
            border-radius: 25px;
            padding: 9px 22px !important;
            margin-left: 8px;
        }

        .register-btn:hover {
            color: white !important;
            background: #e63b31;
        }

        /* ================= HERO ================= */

        .hero {
            min-height: 350px;
            background:
                linear-gradient(90deg,
                    rgba(0, 0, 0, .90),
                    rgba(0, 0, 0, .55),
                    rgba(0, 0, 0, .15)),
                url("https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1800&q=85");

            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            color: white;
        }

        .hero-content {
            max-width: 600px;
        }

        .hero h1 {
            font-size: 52px;
            line-height: 1.08;
            font-weight: 800;
        }

        .hero h1 span {
            color: #ffb52e;
        }

        .hero p {
            font-size: 17px;
            color: #e5e7eb;
            margin-top: 18px;
        }

        /* ================= FILTER BOX ================= */

        .filter-wrapper {
            margin-top: -40px;
            position: relative;
            z-index: 5;
        }

        .filter-box {
            background: white;
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .15);
        }

        .filter-label {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            height: 45px;
            border: 1px solid #e5e7eb;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #ff493d;
            box-shadow: 0 0 0 3px rgba(255, 73, 61, .1);
        }

        .search-btn {
            height: 45px;
            border: none;
            border-radius: 10px;
            background: #ff493d;
            color: white;
            font-weight: 600;
            width: 100%;
        }

        .search-btn:hover {
            background: #e63b31;
        }

        .clear-btn {
            margin-top: 12px;
            border-radius: 8px;
            font-size: 12px;
        }

        /* ================= CATEGORY ================= */

        .categories {
            padding: 35px 0 20px;
        }

        .category-item {
            text-align: center;
            cursor: pointer;
            transition: .2s;
        }

        .category-item:hover {
            transform: translateY(-5px);
        }

        .category-icon {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: #fff0ed;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 30px;
            margin: auto;
        }

        .category-item p {
            margin-top: 8px;
            font-size: 13px;
            font-weight: 500;
        }

        /* ================= SECTION ================= */

        .section-title {
            font-size: 28px;
            font-weight: 800;
        }

        .section-subtitle {
            color: #777;
            font-size: 13px;
        }

        /* ================= FOOD CARD ================= */

        .food-card {
            background: white;
            border: none;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0, 0, 0, .09);
            height: 100%;
            transition: .25s;
        }

        .food-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, .15);
        }

        .food-image {
            height: 185px;
            width: 100%;
            object-fit: cover;
        }

        .food-body {
            padding: 15px;
        }

        .food-name {
            font-size: 17px;
            font-weight: 700;
            text-transform: capitalize;
            margin-bottom: 5px;
        }

        .rating {
            color: #f59e0b;
            font-size: 13px;
        }

        .category-text {
            font-size: 12px;
            color: #777;
            margin: 5px 0;
        }

        .restaurant-name {
            font-size: 12px;
            color: #555;
            margin-bottom: 8px;
        }

        .price {
            font-size: 17px;
            font-weight: 700;
            color: #159447;
        }

        .cart-btn {
            width: 100%;
            border: none;
            background: #ff493d;
            color: white;
            border-radius: 9px;
            padding: 10px;
            font-size: 13px;
            font-weight: 600;
            margin-top: 10px;
        }

        .cart-btn:hover {
            background: #e63b31;
        }

        /* ================= CUSTOMER ACTIONS ================= */

        .customer-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        .customer-actions form {
            flex: 1;
            margin: 0;
        }

        .order-btn {
            width: 100%;
            border: none;
            background: #198754;
            color: white;
            border-radius: 9px;
            padding: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .order-btn:hover {
            background: #157347;
        }

        /* ================= ADMIN ACTIONS ================= */

        .admin-actions {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }

        .admin-actions form {
            flex: 1;
            margin: 0;
        }

        .edit-btn,
        .delete-btn {
            flex: 1;
            width: 100%;
            border: none;
            border-radius: 8px;
            padding: 9px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
        }

        .edit-btn {
            background: #ffc107;
            color: #222;
        }

        .edit-btn:hover {
            background: #e0a800;
            color: #222;
        }

        .delete-btn {
            background: #dc3545;
            color: white;
        }

        .delete-btn:hover {
            background: #bb2d3b;
        }

        /* ================= EMPTY ================= */

        .empty-box {
            text-align: center;
            padding: 70px 20px;
            color: #777;
        }

        .empty-box h4 {
            color: #333;
            font-weight: 700;
        }

        /* ================= FEATURES ================= */

        .features {
            margin-top: 45px;
            margin-bottom: 40px;
            background: #fff2ef;
            border-radius: 20px;
            padding: 22px;
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .feature-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .feature-title {
            font-weight: 700;
            font-size: 13px;
        }

        .feature-text {
            font-size: 11px;
            color: #777;
        }

        /* ================= FOOTER ================= */

        footer {
            background: #111827;
            color: white;
            padding: 25px 0;
            margin-top: 50px;
            text-align: center;
        }

        footer p {
            margin: 0;
            color: #cbd5e1;
            font-size: 13px;
        }

        @media(max-width: 768px) {

            .hero h1 {
                font-size: 38px;
            }

            .filter-wrapper {
                margin-top: 20px;
            }

            .hero {
                min-height: 400px;
            }

            .nav-link {
                margin: 5px 0;
            }
        }
    </style>
</head>

