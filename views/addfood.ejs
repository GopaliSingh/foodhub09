<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Food | FoodHub</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            padding: 40px 20px;
            color: #333;
        }

        .container {
            width: 100%;
            max-width: 650px;
            margin: auto;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .header h1 {
            font-size: 32px;
            color: #e85d04;
        }

        .header p {
            color: #777;
            margin-top: 5px;
            font-size: 14px;
        }

        .stats-btn {
            text-decoration: none;
            background: #343a40;
            color: white;
            padding: 11px 16px;
            border-radius: 8px;
            font-size: 14px;
            transition: 0.3s;
        }

        .stats-btn:hover {
            background: #212529;
            transform: translateY(-2px);
        }

        /* Card */
        .form-card {
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10);
        }

        .form-title {
            font-size: 22px;
            margin-bottom: 25px;
            color: #333;
            border-bottom: 2px solid #f1f1f1;
            padding-bottom: 15px;
        }

        /* Form */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            color: #444;
        }

        input,
        select {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #ddd;
            border-radius: 9px;
            font-size: 15px;
            outline: none;
            background: #fafafa;
            transition: 0.3s;
        }

        input:focus,
        select:focus {
            border-color: #e85d04;
            background: white;
            box-shadow: 0 0 0 3px rgba(232, 93, 4, 0.10);
        }

        input[type="file"] {
            padding: 10px;
            cursor: pointer;
        }

        /* Submit button */
        .submit-btn {
            width: 100%;
            border: none;
            background: linear-gradient(135deg, #e85d04, #f48c06);
            color: white;
            padding: 14px;
            border-radius: 9px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.3s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(232, 93, 4, 0.3);
        }

        /* Back button */
        .back-btn {
            display: block;
            text-align: center;
            margin-top: 18px;
            color: #666;
            text-decoration: none;
            font-size: 14px;
        }

        .back-btn:hover {
            color: #e85d04;
        }

        /* Responsive */
        @media (max-width: 600px) {

            body {
                padding: 20px 12px;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .header h1 {
                font-size: 27px;
            }

            .stats-btn {
                width: 100%;
                text-align: center;
            }

            .form-card {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->
        <div class="header">

            <div>
                <h1>🍽️ Add New Food</h1>
                <p>Add a delicious item to your FoodHub menu</p>
            </div>

            <a href="/admin/statistics" class="stats-btn">
                📊 View Statistics
            </a>

        </div>


        <!-- Form Card -->
        <div class="form-card">

            <h2 class="form-title">Food Details</h2>

            <form action="/add-food" method="POST" enctype="multipart/form-data">

                <!-- Food Name -->
                <div class="form-group">
                    <label for="name">Food Name</label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Enter food name"
                        required
                    >
                </div>


                <!-- Price -->
                <div class="form-group">
                    <label for="price">Price (₹)</label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        placeholder="Enter price"
                        min="0"
                        required
                    >
                </div>


                <!-- Category -->
                <div class="form-group">
                    <label for="category">Category</label>

                    <select name="category" id="category" required>

                        <option value="">Select Category</option>

                        <option value="Pizza">🍕 Pizza</option>
                        <option value="Burger">🍔 Burger</option>
                        <option value="Biryani">🍛 Biryani</option>
                        <option value="Dessert">🍰 Dessert</option>
                        <option value="Drinks">🥤 Drinks</option>

                    </select>
                </div>


                <!-- Restaurant -->
                <div class="form-group">
                    <label for="restaurant">Restaurant</label>

                    <select name="restaurant" id="restaurant" required>

                        <option value="">Select Restaurant</option>

                        <% restaurants.forEach(restaurant => { %>

                            <option value="<%= restaurant._id %>">
                                <%= restaurant.name %>
                            </option>

                        <% }) %>

                    </select>
                </div>


                <!-- Image -->
                <div class="form-group">
                    <label for="image">Food Image</label>

                    <input
                        type="file"
                        id="image"
                        name="image"
                        accept="image/*"
                    >
                </div>


                <!-- Submit -->
                <button type="submit" class="submit-btn">
                    ➕ Add Food
                </button>

            </form>

            <a href="/" class="back-btn">
                ← Back to FoodHub
            </a>

        </div>

    </div>

</body>
</html>