<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Statistics | FoodieHub</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                🍔 FoodieHub Admin
            </a>

            <a href="/" class="btn btn-outline-light">
                Home
            </a>

        </div>
    </nav>


    <div class="container py-5">

        <div class="mb-4">
            <h1 class="fw-bold">
                Admin Statistics
            </h1>

            <p class="text-muted">
                Overview of your FoodieHub platform
            </p>
        </div>


        <div class="row g-4">


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Total Users</h5>
                        <h2 class="fw-bold">
                            <%= totalUsers %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Total Restaurants</h5>
                        <h2 class="fw-bold">
                            <%= totalRestaurants %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Total Foods</h5>
                        <h2 class="fw-bold">
                            <%= totalFoods %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Total Orders</h5>
                        <h2 class="fw-bold">
                            <%= totalOrders %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Paid Orders</h5>
                        <h2 class="fw-bold text-success">
                            <%= paidOrders %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Pending Orders</h5>
                        <h2 class="fw-bold text-warning">
                            <%= pendingOrders %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Cancelled Orders</h5>
                        <h2 class="fw-bold text-danger">
                            <%= cancelledOrders %>
                        </h2>
                    </div>
                </div>
            </div>


            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5>Total Revenue</h5>

                        <h2 class="fw-bold text-success">
                            ₹<%= Number(totalRevenue).toFixed(2) %>
                        </h2>

                        <p class="text-muted mb-0">
                            Revenue from paid orders
                        </p>
                    </div>
                </div>
            </div>


        </div>

    </div>

</body>

</html>