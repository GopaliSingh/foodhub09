<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Orders | FoodieHub</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Razorpay Checkout -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

</head>


<body class="bg-light">

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a
                class="navbar-brand fw-bold"
                href="/">

                🍔 FoodieHub

            </a>


            <div class="ms-auto">

                <a
                    href="/"
                    class="btn btn-outline-light me-2">

                    Home

                </a>


                <a
                    href="/profile"
                    class="btn btn-outline-light me-2">

                    Profile

                </a>


                <a
                    href="/logout"
                    class="btn btn-danger">

                    Logout

                </a>

            </div>

        </div>

    </nav>


    <!-- Orders -->

    <div class="container py-5">

        <div class="text-center mb-4">

            <h1 class="fw-bold">
                My Orders
            </h1>

            <p class="text-muted">
                View and manage your food orders
            </p>

        </div>


        <% if (orders.length === 0) { %>

            <div class="alert alert-info text-center">

                <h5>
                    You haven't placed any orders yet.
                </h5>

                <p class="mb-0">

                    Explore our menu and place your first order.

                </p>

            </div>


        <% } else { %>


            <div class="row">

                <% orders.forEach(order => { %>


                    <div class="col-md-6 col-lg-4 mb-4">

                        <div class="card shadow-sm h-100">


                            <div class="card-body">


                                <!-- Food -->

                                <h4 class="card-title fw-bold">

                                    <% if (order.food) { %>

                                        <%= order.food.name %>

                                    <% } else { %>

                                        Food item unavailable

                                    <% } %>

                                </h4>


                                <!-- Restaurant -->

                                <p class="mb-2">

                                    <strong>
                                        Restaurant:
                                    </strong>

                                    <% if (order.restaurant) { %>

                                        <%= order.restaurant.name %>

                                    <% } else { %>

                                        Restaurant unavailable

                                    <% } %>

                                </p>


                                <!-- Quantity -->

                                <p class="mb-2">

                                    <strong>
                                        Quantity:
                                    </strong>

                                    <%= order.quantity %>

                                </p>


                                <!-- Total -->

                                <p class="mb-2">

                                    <strong>
                                        Total:
                                    </strong>

                                    <span class="text-success fw-bold">

                                        ₹<%= order.total %>

                                    </span>

                                </p>


                                <!-- Status -->

                                <p class="mb-2">

                                    <strong>
                                        Status:
                                    </strong>

                                    <span class="badge bg-secondary">

                                        <%= order.status %>

                                    </span>

                                </p>


                                <!-- Payment Status -->

                                <p class="mb-3">

                                    <strong>
                                        Payment Status:
                                    </strong>

                                    <% if (order.paymentStatus === "paid") { %>

                                        <span class="badge bg-success">

                                            Paid

                                        </span>

                                    <% } else if (order.paymentStatus === "failed") { %>

                                        <span class="badge bg-danger">

                                            Failed

                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-warning text-dark">

                                            Pending

                                        </span>

                                    <% } %>

                                </p>


                                <!-- PAYMENT -->

                                <% if (
                                    order.paymentStatus !== "paid" &&
                                    order.status !== "cancelled" &&
                                    order.food
                                ) { %>


                                    <button
                                        type="button"
                                        class="btn btn-success w-100 mb-2"
                                        onclick="payNow('<%= order._id %>')">

                                        💳 Pay Now

                                    </button>


                                <% } else if (order.paymentStatus === "paid") { %>


                                    <div class="alert alert-success py-2 text-center">

                                        <strong>

                                            Payment Completed ✅

                                        </strong>

                                    </div>


                                <% } %>


                                <!-- CHAT -->

                                <% if (order.food && order.restaurant) { %>

                                    <a
                                        href="/orders/<%= order._id %>/chat"
                                        class="btn btn-outline-primary w-100">

                                        💬 Chat with Restaurant

                                    </a>

                                <% } %>


                            </div>


                        </div>

                    </div>


                <% }) %>


            </div>


        <% } %>


    </div>


    <!-- Footer -->

    <footer class="bg-dark text-white text-center py-3">

        <p class="mb-0">

            © 2026 FoodieHub. All rights reserved.

        </p>

    </footer>



    <!-- Razorpay Payment Script -->

    <script>

        async function payNow(orderId) {

            try {

                // Create Razorpay order

                const response =
                    await fetch(
                        `/orders/${orderId}/payment`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            }
                        }
                    );


                const data =
                    await response.json();


                if (!data.success) {

                    alert(
                        data.message ||
                        "Payment initialization failed"
                    );

                    return;

                }


                // Razorpay Checkout

                const options = {

                    key:
                        "<%= process.env.RAZORPAY_KEY_ID %>",

                    amount:
                        data.paymentOrder.amount,

                    currency:
                        data.paymentOrder.currency,

                    name:
                        "FoodieHub",

                    description:
                        "Food Order",

                    order_id:
                        data.paymentOrder.id,


                    handler:
                        async function(response) {

                            try {

                                const verifyResponse =
                                    await fetch(
                                        `/orders/${orderId}/payment/verify`,
                                        {
                                            method: "POST",

                                            headers: {
                                                "Content-Type":
                                                    "application/json"
                                            },

                                            body:
                                                JSON.stringify({

                                                    razorpay_order_id:
                                                        response.razorpay_order_id,

                                                    razorpay_payment_id:
                                                        response.razorpay_payment_id,

                                                    razorpay_signature:
                                                        response.razorpay_signature

                                                })

                                        }
                                    );


                                const verificationData =
                                    await verifyResponse.json();


                                if (
                                    verificationData.success
                                ) {

                                    alert(
                                        "Payment verified successfully!"
                                    );

                                    window.location.reload();

                                } else {

                                    alert(
                                        verificationData.message ||
                                        "Payment verification failed."
                                    );

                                }


                            } catch (error) {

                                console.log(error);

                                alert(
                                    "Something went wrong while verifying payment."
                                );

                            }

                        },


                    theme: {

                        color:
                            "#198754"

                    }

                };


                const razorpay =
                    new Razorpay(options);


                razorpay.open();


            } catch (error) {

                console.log(error);

                alert(
                    "Something went wrong while starting payment."
                );

            }

        }

    </script>


</body>

</html>