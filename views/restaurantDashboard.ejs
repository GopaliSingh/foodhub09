<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>FoodieHub Admin Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #f5f6fa;
        }

        /* NAVBAR */

        .navbar {
            background: #111827;
            padding: 15px 0;
        }

        .brand {
            color: white;
            font-size: 24px;
            font-weight: 800;
            text-decoration: none;
        }

        .brand span {
            color: #ff493d;
        }

        .navbar a {
            color: #e5e7eb;
            text-decoration: none;
        }

        .logout-btn {
            border: 1px solid #ff493d;
            color: #ff493d !important;
            border-radius: 20px;
            padding: 7px 18px;
        }

        /* PAGE */

        .dashboard {
            padding: 35px 0;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h1 {
            font-size: 30px;
            font-weight: 800;
        }

        .welcome p {
            color: #777;
        }

        /* STAT CARDS */

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 22px;
            box-shadow: 0 5px 20px rgba(0,0,0,.07);
            height: 100%;
        }

        .stat-icon {
            font-size: 30px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: 800;
            margin-top: 8px;
        }

        .stat-title {
            color: #777;
            font-size: 13px;
        }

        /* SECTION */

        .section-card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,.07);
            margin-top: 30px;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        /* FOOD CARD */

        .food-card {
            border: 1px solid #eee;
            border-radius: 14px;
            overflow: hidden;
            height: 100%;
            background: white;
            transition: .2s;
        }

        .food-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,.10);
        }

        .food-image {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

        .food-content {
            padding: 15px;
        }

        .food-name {
            font-size: 17px;
            font-weight: 700;
        }

        .food-category {
            color: #777;
            font-size: 12px;
        }

        .food-price {
            color: #159447;
            font-weight: 700;
            margin: 8px 0;
        }

        /* ORDER */

        .order-card {
            border: 1px solid #eee;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 15px;
            background: #fff;
        }

        .order-id {
            font-size: 13px;
            color: #777;
        }

        .status {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            background: #fff3cd;
            color: #856404;
            font-size: 12px;
            font-weight: 600;
        }

        .update-btn {
            background: #ff493d;
            border: none;
            color: white;
            border-radius: 8px;
            padding: 8px 15px;
        }

        .update-btn:hover {
            background: #e63b31;
            color: white;
        }

        .edit-btn {
            background: #ffc107;
            border: none;
            color: #222;
            border-radius: 7px;
            padding: 7px 12px;
        }

        .delete-btn {
            background: #dc3545;
            border: none;
            color: white;
            border-radius: 7px;
            padding: 7px 12px;
        }

        .add-food-btn {
            background: #ff493d;
            color: white;
            border: none;
            border-radius: 9px;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 600;
        }

        .add-food-btn:hover {
            background: #e63b31;
            color: white;
        }

    </style>

</head>

<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar">

    <div class="container d-flex justify-content-between align-items-center">

        <a href="/" class="brand">
            🍔 Foodie<span>Hub</span>
        </a>

        <div class="d-flex align-items-center gap-4">

            <a href="/">
                View Store
            </a>

            <a href="/add-food">
                Add Food
            </a>

            <a href="/login" class="logout-btn">
                Logout
            </a>

        </div>

    </div>

</nav>



<!-- ================= DASHBOARD ================= -->

<div class="container dashboard">


    <!-- HEADER -->

    <div class="welcome">

        <h1>
            👋 Restaurant Dashboard
        </h1>

        <p>
            Manage your food items and customer orders.
        </p>

    </div>



    <!-- ================= STATS ================= -->

    <div class="row g-4">


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon">
                    🍔
                </div>

                <div class="stat-number">
                    <%= foods ? foods.length : 0 %>
                </div>

                <div class="stat-title">
                    Food Items
                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon">
                    📦
                </div>

                <div class="stat-number">
                    <%= orders ? orders.length : 0 %>
                </div>

                <div class="stat-title">
                    Customer Orders
                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon">
                    🏪
                </div>

                <div class="stat-number">
                    <%= restaurant ? restaurant.name : "Restaurant" %>
                </div>

                <div class="stat-title">
                    Your Restaurant
                </div>

            </div>

        </div>

    </div>



    <!-- ================= FOOD MANAGEMENT ================= -->

    <div class="section-card">

        <div class="d-flex justify-content-between align-items-center">

            <div class="section-title">
                🍔 Food Management
            </div>

            <a href="/add-food" class="add-food-btn">
                + Add New Food
            </a>

        </div>


        <% if (foods && foods.length > 0) { %>

            <div class="row g-4">

                <% foods.forEach(food => { %>

                    <div class="col-xl-3 col-lg-4 col-md-6">

                        <div class="food-card">

                            <img
                                src="<%= food.image || 'https://via.placeholder.com/400x250?text=Food' %>"
                                class="food-image"
                                alt="<%= food.name %>">

                            <div class="food-content">

                                <div class="food-name">
                                    <%= food.name %>
                                </div>

                                <div class="food-category">
                                    Category: <%= food.category %>
                                </div>

                                <div class="food-price">
                                    ₹<%= food.price %>
                                </div>


                                <!-- EDIT -->

                                <a
                                    href="/foods/<%= food._id %>/edit"
                                    class="btn btn-sm edit-btn">

                                    ✏️ Edit

                                </a>


                                <!-- DELETE -->

                                <form
                                    action="/foods/<%= food._id %>/delete"
                                    method="POST"
                                    style="display:inline;">

                                    <button
                                        type="submit"
                                        class="btn btn-sm delete-btn"
                                        onclick="return confirm('Delete this food?')">

                                        🗑️ Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="text-center py-5">

                <div style="font-size:50px;">
                    🍽️
                </div>

                <h5>
                    No food items yet
                </h5>

                <p class="text-muted">
                    Add your first food item.
                </p>

            </div>

        <% } %>

    </div>



    <!-- ================= ORDERS ================= -->

    <div class="section-card">

        <div class="section-title">
            📦 Customer Orders
        </div>


        <% if (orders && orders.length > 0) { %>


            <% orders.forEach(order => { %>

                <div class="order-card">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="order-id">
                                Order #<%= order._id %>
                            </div>

                            <h5 class="mt-2">
                                👤 <%= order.user.name %>
                            </h5>

                        </div>

                        <div>

                            <span class="status">
                                <%= order.status %>
                            </span>

                        </div>

                    </div>


                    <hr>


                    <p>
                        <strong>📧 Email:</strong>
                        <%= order.user.email %>
                    </p>


                    <p>
                        <strong>🍔 Food:</strong>
                        <%= order.food.name %>
                    </p>


                    <p>
                        <strong>💰 Price:</strong>
                        ₹<%= order.food.price %>
                    </p>


                    <p>
                        <strong>🔢 Quantity:</strong>
                        <%= order.quantity %>
                    </p>


                    <p>
                        <strong>💵 Total:</strong>
                        ₹<%= order.totalPrice %>
                    </p>



                    <!-- UPDATE ORDER -->

                    <form
                        action="/orders/<%= order._id %>/status"
                        method="POST"
                        class="d-flex gap-2 align-items-center">

                        <select
                            name="status"
                            class="form-select"
                            style="max-width:220px;">

                            <option
                                value="pending"
                                <%= order.status === "pending" ? "selected" : "" %>>
                                Pending
                            </option>

                            <option
                                value="confirmed"
                                <%= order.status === "confirmed" ? "selected" : "" %>>
                                Confirmed
                            </option>

                            <option
                                value="preparing"
                                <%= order.status === "preparing" ? "selected" : "" %>>
                                Preparing
                            </option>

                            <option
                                value="delivered"
                                <%= order.status === "delivered" ? "selected" : "" %>>
                                Delivered
                            </option>

                            <option
                                value="cancelled"
                                <%= order.status === "cancelled" ? "selected" : "" %>>
                                Cancelled
                            </option>

                        </select>


                        <button
                            type="submit"
                            class="update-btn">

                            🔄 Update Status

                        </button>

                    </form>

                </div>

            <% }) %>


        <% } else { %>

            <div class="text-center py-5">

                <div style="font-size:50px;">
                    📦
                </div>

                <h5>
                    No orders yet
                </h5>

                <p class="text-muted">
                    Customer orders will appear here.
                </p>

            </div>

        <% } %>

    </div>

</div>


</body>

</html>