                <input
                    type="number"
                    id="minPriceInput"
                    class="form-control"
                    placeholder="Min"
                    min="0">
            </div>

            <div class="col-lg-2 col-md-6">
                <div class="filter-label">₹ Max Price</div>
                <input
                    type="number"
                    id="maxPriceInput"
                    class="form-control"
                    placeholder="Max"
                    min="0">
            </div>

            <div class="col-lg-2 col-md-6">
                <div class="filter-label">↕ Sort</div>
                <select id="sortInput" class="form-select">
